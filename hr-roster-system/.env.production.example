# 复制为 .env.production 后替换全部密码和密钥，禁止提交真实配置。
MYSQL_ROOT_PASSWORD=请替换为数据库Root强密码
DB_PASSWORD=请替换为应用数据库强密码
JWT_SECRET=请使用openssl_rand_hex_32生成至少32位随机字符串
CORS_ORIGINS=https://lczpt.com,https://www.lczpt.com

# 必须分别为32字符和16字符，上线后不可随意更换；IV仅用于兼容历史v1密文。
DATA_ENCRYPT_KEY=请替换为32字符随机密钥__________
DATA_ENCRYPT_IV=请替换16字符密钥

# 微信小程序员工登录。仅填写当前小程序的 AppID 和 AppSecret，禁止写入代码或日志。
WECHAT_MINIPROGRAM_APPID=
WECHAT_MINIPROGRAM_SECRET=
WECHAT_MINIPROGRAM_URL_SCHEME=

# 微信公众号服务号通知。仅写入腾讯云生产环境，不要提交真实密钥。
WECHAT_OFFICIAL_ENABLED=false
WECHAT_OFFICIAL_APPID=
WECHAT_OFFICIAL_SECRET=
WECHAT_OFFICIAL_TEMPLATE_PAYSLIP_PUBLISHED=
WECHAT_OFFICIAL_TEMPLATE_PAYSLIP_REMINDER=
WECHAT_OFFICIAL_REDIRECT_URI=https://lczpt.com/api/wechat/official/callback

# 员工绑定票据 HMAC 密钥，至少32字节，须与 JWT_SECRET 使用不同的随机值。
EMPLOYEE_BIND_HMAC_SECRET=

# 腾讯云身份证 OCR（优先使用实例角色；无角色时填写腾讯云 API 密钥）
TENCENT_OCR_REGION=ap-shanghai
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=

# 腾讯云短信：签名和模板审核通过后再改为true。
TENCENT_SMS_ENABLED=false
TENCENT_SMS_REGION=ap-guangzhou
TENCENT_SMS_SDK_APP_ID=
TENCENT_SMS_SIGN_NAME=
TENCENT_SMS_TEMPLATE_LOGIN_CODE=
TENCENT_SMS_TEMPLATE_PAYSLIP_PUBLISHED=2727678
TENCENT_SMS_TEMPLATE_PAYSLIP_REMINDER=2727678
# 工资条短信模板需预留1个变量，填写微信官方 URL Link；URL Link 的目标页面配置为 /pages/login/index。
# 链接不得带 query/hash 或员工、工资条、Token 等业务参数。
TENCENT_SMS_PAYSLIP_URL_LINK=
# 短信验证码HMAC密钥，至少32字节，不得与JWT或员工绑定密钥共用。
SMS_CODE_HMAC_SECRET=
